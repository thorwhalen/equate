{
  "name": "equate-review-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Review UI for equate's matching service: review queue, confirm/reject/reassign, active-learning labelling.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "ci-local": "npm test && npm run build"
  },
  "dependencies": {
    "@zodal/core": "0.2.0",
    "@zodal/store": "0.2.0",
    "@zodal/store-localstorage": "0.2.0",
    "@zodal/ui": "0.2.0",
    "@zodal/ui-shadcn": "0.1.0",
    "clsx": "^2.1.1",
    "immer": "^10.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.5.4",
    "zod": "^4.1.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.3",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.1.3",
    "typescript": "~5.7.2",
    "vite": "^6.0.7",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "@zodal/ui-shadcn": {
      "@zodal/core": "$@zodal/core",
      "@zodal/ui": "$@zodal/ui"
    }
  },
  "wads": {
    "ci": {
      "nodeVersions": [
        "20",
        "22"
      ],
      "publish": {
        "enabled": false
      }
    }
  }
}
